//@version=5
// © 2026 Trade_Prod — Support Scalping Confluence (Pine port)
// =============================================================
// Pine v5 port of backend Support Scalp Engine
//   • supportScalpEngine.js  (5-confluence + scoring)
//   • supportScalpValidator.js (15-point pre-fire validator)
//
// SIGNALS (color-coded by total confidence score)
//   ◌ YELLOW circle    — light    (score ≥ 50)
//   ◇ ORANGE diamond   — medium   (score ≥ 65)
//   ▲ BLUE   triangle  — strong   (score ≥ 80)
//   ⏶⏶ GREEN double    — very strong (score ≥ 90)
// SELL mirrors downward.
//
// LIMITATIONS
// TradingView cannot read NSE option-chain OI/Greeks/spread for NIFTY
// weeklies, so those checks use spot-derived PROXIES:
//   IV proxy   ≈ ATR/price %
//   Gamma proxy≈ rising ATR(5) over ATR(20)
//   OI flow   ≈ 5-bar SMA of signed volume
// =============================================================

indicator("Support Scalp Confluence", shorttitle="SS-Confluence", overlay=true, max_labels_count=500)

// ─── INPUTS ─────────────────────────────────────────────────
gUT     = "UT Bot"
ut_key  = input.float(1.5,  "UT Bot Key Value", step=0.1, group=gUT)
ut_atr  = input.int  (10,   "UT Bot ATR Period",          group=gUT)

gST     = "Supertrend"
st_atr  = input.int  (10,   "Supertrend ATR Period", group=gST)
st_mult = input.float(2.5,  "Supertrend Multiplier", step=0.1, group=gST)

gEMA    = "EMA"
ema_fast = input.int(9,  "EMA Fast", group=gEMA)
ema_slow = input.int(20, "EMA Slow", group=gEMA)
ema_tol  = input.float(0.01, "EMA Tolerance %", step=0.01, group=gEMA)

gRSI    = "RSI"
rsi_len = input.int(14, "RSI Period",   group=gRSI)
rsi_lo  = input.int(55, "RSI Long Min", group=gRSI)
rsi_hi  = input.int(45, "RSI Short Max",group=gRSI)

gMTF    = "Multi-Timeframe"
tf_5m   = input.timeframe("5",  "Confirm TF #1", group=gMTF)
tf_15m  = input.timeframe("15", "Confirm TF #2", group=gMTF)
tf_1m   = input.timeframe("1",  "Recent Bar TF", group=gMTF)

gVOL    = "Volume / Momentum"
vol_lookback = input.int(20,    "Volume avg bars",     group=gVOL)
vol_mul      = input.float(1.5, "Volume spike multiplier", step=0.1, group=gVOL)
mom_pct      = input.float(0.08,"Momentum % over 3 bars",  step=0.01, group=gVOL)

gATR    = "ATR / IV proxy"
atr_min      = input.float(4.0,  "Min ATR(5m) pts",            step=0.5, group=gATR)
iv_proxy_min = input.float(0.10, "Min ATR/Price %",            step=0.05, group=gATR)
iv_proxy_max = input.float(2.50, "Max ATR/Price %",            step=0.10, group=gATR)

gSC     = "Scoring"
w_utbot = input.int(30, "Weight UT Bot",   group=gSC)
w_mtf   = input.int(20, "Weight MTF",      group=gSC)
w_st    = input.int(15, "Weight Supertrend", group=gSC)
w_ema   = input.int(10, "Weight EMA",      group=gSC)
w_rsi   = input.int(10, "Weight RSI",      group=gSC)
w_vwap  = input.int(10, "Weight VWAP",     group=gSC)
w_mom   = input.int(15, "Weight Momentum", group=gSC)
w_vol   = input.int(10, "Weight Volume",   group=gSC)
w_oi    = input.int(10, "Weight OI proxy", group=gSC)

th_light   = input.int(50, "Threshold light (yellow)",   group=gSC)
th_med     = input.int(65, "Threshold medium (orange)",  group=gSC)
th_strong  = input.int(80, "Threshold strong (blue)",    group=gSC)
th_vstrong = input.int(90, "Threshold very strong (green ⏶⏶)", group=gSC)

gSH     = "Display"
show_lines = input.bool(true, "Show VWAP / EMA / Supertrend", group=gSH)
show_score = input.bool(true, "Show score label",             group=gSH)
show_poc   = input.bool(true, "Show Volume Profile POC",      group=gSH)
poc_lookback = input.int(50,  "POC lookback bars",            group=gSH)

// ─── 1. UT BOT ALERTS (cross of close vs ATR trailing stop) ─
utBotPos(_src, _key, _atrPeriod) =>
    nLoss = _key * ta.atr(_atrPeriod)
    var float stop = na
    var int   pos  = 0
    src1 = nz(_src[1])
    prev = nz(stop[1], _src - nLoss)
    float newStop = _src + nLoss
    if _src > prev and src1 > prev
        newStop := math.max(prev, _src - nLoss)
    else if _src < prev and src1 < prev
        newStop := math.min(prev, _src + nLoss)
    else if _src > prev
        newStop := _src - nLoss
    else
        newStop := _src + nLoss
    stop := newStop
    int newPos = nz(pos[1])
    if src1 < nz(stop[1]) and _src > stop
        newPos := 1
    else if src1 > nz(stop[1]) and _src < stop
        newPos := -1
    pos := newPos
    pos

utPos = utBotPos(close, ut_key, ut_atr)
utBuy  = utPos ==  1 and nz(utPos[1]) !=  1
utSell = utPos == -1 and nz(utPos[1]) != -1
utBuyOrRecent  = utBuy  or utBuy[1]
utSellOrRecent = utSell or utSell[1]

// ─── 2. SUPERTREND ──────────────────────────────────────────
[stLine, stDir] = ta.supertrend(st_mult, st_atr)
stGreen = stDir < 0
stRed   = stDir > 0

// ─── 3. VWAP ────────────────────────────────────────────────
vwapVal   = ta.vwap(hlc3)
vwapAbove = close > vwapVal
vwapBelow = close < vwapVal

// ─── 4. EMA 9 / EMA 20 ──────────────────────────────────────
ema9       = ta.ema(close, ema_fast)
ema20      = ta.ema(close, ema_slow)
emaDiffPct = math.abs(ema9 - ema20) / math.max(1.0, ema20) * 100
emaUp      = ema9 > ema20 or emaDiffPct <= ema_tol
emaDown    = ema9 < ema20 or emaDiffPct <= ema_tol

// ─── 5. RSI(14) ─────────────────────────────────────────────
rsiVal   = ta.rsi(close, rsi_len)
rsiLong  = rsiVal >= rsi_lo
rsiShort = rsiVal <= rsi_hi

// ─── 6. MULTI-TIMEFRAME UT BOT ──────────────────────────────
utPos5m    = request.security(syminfo.tickerid, tf_5m,  utBotPos(close, 2.0, 10))
utPos15m   = request.security(syminfo.tickerid, tf_15m, utBotPos(close, 2.5, 14))
last1mUp   = request.security(syminfo.tickerid, tf_1m, close > open)
last1mDown = request.security(syminfo.tickerid, tf_1m, close < open)

// ─── 7. VOLUME SPIKE ────────────────────────────────────────
volAvg        = ta.sma(volume, vol_lookback)
volSpikeRatio = volAvg > 0 ? volume / volAvg : 0.0
volSpike      = volSpikeRatio >= vol_mul

// ─── 8. MOMENTUM BURST (3-bar % move) ──────────────────────
mom3    = (close - close[3]) / close[3] * 100
momUp   = mom3 >=  mom_pct
momDown = mom3 <= -mom_pct

// ─── 9. ATR HEALTH + IV PROXY ──────────────────────────────
atrPts5m   = request.security(syminfo.tickerid, tf_5m, ta.atr(14))
atrHealthy = atrPts5m >= atr_min
ivProxyPct = atrPts5m / close * 100
ivHealthy  = ivProxyPct >= iv_proxy_min and ivProxyPct <= iv_proxy_max

// ─── 10. OI-FLOW PROXY + GAMMA PROXY ───────────────────────
signedVol   = (close > open ? 1 : close < open ? -1 : 0) * volume
oiFlow      = ta.sma(signedVol, 5)
oiBullProxy = oiFlow > 0
oiBearProxy = oiFlow < 0
atrFast     = ta.atr(5)
atrSlow     = ta.atr(20)
gammaProxy  = atrFast > atrSlow

// ─── 11. VOLUME PROFILE — POC (lightweight) ────────────────
var float pocLevel = na
if barstate.islast and show_poc
    var float[] binVol = array.new_float(30, 0.0)
    for i = 0 to 29
        array.set(binVol, i, 0.0)
    hi  = ta.highest(high, poc_lookback)
    lo  = ta.lowest (low,  poc_lookback)
    rng = math.max(1e-6, hi - lo)
    for i = 0 to poc_lookback - 1
        c = nz(close[i])
        v = nz(volume[i])
        rawIdx = math.floor((c - lo) / rng * 29)
        idx = int(math.max(0.0, math.min(29.0, rawIdx)))
        array.set(binVol, idx, array.get(binVol, idx) + v)
    int   maxIdx = 0
    float maxV   = 0.0
    for i = 0 to 29
        v = array.get(binVol, i)
        if v > maxV
            maxV := v
            maxIdx := i
    pocLevel := lo + (maxIdx + 0.5) * (rng / 30)

pocAbove = not na(pocLevel) and close > pocLevel
pocBelow = not na(pocLevel) and close < pocLevel

// ─── SCORING (mirrors backend supportScalpEngine.decide) ───
scoreBull() =>
    s = 0
    s += utBuyOrRecent ? w_utbot : 0
    int mtfHit = 0
    if utPos5m  ==  1
        mtfHit += math.floor(w_mtf / 2)
    if utPos15m ==  1
        mtfHit += math.floor(w_mtf / 2)
    s += mtfHit
    s += stGreen   ? w_st   : -math.floor(w_st   * 0.2)
    s += emaUp     ? w_ema  : -math.floor(w_ema  * 0.5)
    s += rsiLong   ? w_rsi  : 0
    s += vwapAbove ? w_vwap : -math.floor(w_vwap * 0.5)
    s += momUp     ? w_mom  : 0
    s += volSpike  ? w_vol  : 0
    s += oiBullProxy ? w_oi : 0
    s += gammaProxy  ? 5 : 0
    s += pocAbove    ? 5 : 0
    s += (atrHealthy and ivHealthy) ? 5 : -10
    s

scoreBear() =>
    s = 0
    s += utSellOrRecent ? w_utbot : 0
    int mtfHit = 0
    if utPos5m  == -1
        mtfHit += math.floor(w_mtf / 2)
    if utPos15m == -1
        mtfHit += math.floor(w_mtf / 2)
    s += mtfHit
    s += stRed     ? w_st   : -math.floor(w_st   * 0.2)
    s += emaDown   ? w_ema  : -math.floor(w_ema  * 0.5)
    s += rsiShort  ? w_rsi  : 0
    s += vwapBelow ? w_vwap : -math.floor(w_vwap * 0.5)
    s += momDown   ? w_mom  : 0
    s += volSpike  ? w_vol  : 0
    s += oiBearProxy ? w_oi : 0
    s += gammaProxy  ? 5 : 0
    s += pocBelow    ? 5 : 0
    s += (atrHealthy and ivHealthy) ? 5 : -10
    s

buyScore  = scoreBull()
sellScore = scoreBear()

buyEligible  = utBuyOrRecent
sellEligible = utSellOrRecent

buyTier = 0
if buyEligible
    if buyScore >= th_vstrong
        buyTier := 4
    else if buyScore >= th_strong
        buyTier := 3
    else if buyScore >= th_med
        buyTier := 2
    else if buyScore >= th_light
        buyTier := 1

sellTier = 0
if sellEligible
    if sellScore >= th_vstrong
        sellTier := 4
    else if sellScore >= th_strong
        sellTier := 3
    else if sellScore >= th_med
        sellTier := 2
    else if sellScore >= th_light
        sellTier := 1

// ─── PLOTS ─────────────────────────────────────────────────
plot(show_lines ? vwapVal : na, "VWAP",  color=color.new(color.orange,  0), linewidth=2)
plot(show_lines ? ema9    : na, "EMA9",  color=color.new(color.aqua,    0))
plot(show_lines ? ema20   : na, "EMA20", color=color.new(color.fuchsia, 0))
plot(show_lines and stGreen ? stLine : na, "ST Up",   color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=2)
plot(show_lines and stRed   ? stLine : na, "ST Down", color=color.new(color.red,  0), style=plot.style_linebr, linewidth=2)
plot(show_poc   ? pocLevel : na, "POC", color=color.new(color.yellow, 30), style=plot.style_linebr, linewidth=2)

// BUY tiers
plotshape(buyTier == 1, "BUY light",       location=location.belowbar, style=shape.circle,     color=color.yellow,                size=size.tiny)
plotshape(buyTier == 2, "BUY medium",      location=location.belowbar, style=shape.diamond,    color=color.new(color.orange, 0),  size=size.small)
plotshape(buyTier == 3, "BUY strong",      location=location.belowbar, style=shape.triangleup, color=color.new(color.blue,   0),  size=size.normal, text="BUY",     textcolor=color.white)
plotshape(buyTier == 4, "BUY very strong", location=location.belowbar, style=shape.triangleup, color=color.new(color.green,  0),  size=size.large,  text="BUY ⏶⏶", textcolor=color.white)

// SELL tiers
plotshape(sellTier == 1, "SELL light",       location=location.abovebar, style=shape.circle,       color=color.yellow,               size=size.tiny)
plotshape(sellTier == 2, "SELL medium",      location=location.abovebar, style=shape.diamond,      color=color.new(color.orange, 0), size=size.small)
plotshape(sellTier == 3, "SELL strong",      location=location.abovebar, style=shape.triangledown, color=color.new(color.blue,   0), size=size.normal, text="SELL",     textcolor=color.white)
plotshape(sellTier == 4, "SELL very strong", location=location.abovebar, style=shape.triangledown, color=color.new(color.red,    0), size=size.large,  text="SELL ⏷⏷", textcolor=color.white)

// Score label on latest bar
if show_score and barstate.islast
    string txt = "BUY " + str.tostring(buyScore) + "  |  SELL " + str.tostring(sellScore) + "\nUT:" + (utPos == 1 ? "↑" : utPos == -1 ? "↓" : "·") + "  ST:" + (stGreen ? "↑" : "↓") + "  RSI:" + str.tostring(rsiVal, "#.0") + "\nVolX:" + str.tostring(volSpikeRatio, "#.00") + "  ATR%:" + str.tostring(ivProxyPct, "#.00") + "  Mom:" + str.tostring(mom3, "#.00") + "%"
    label.new(bar_index, high, txt, style=label.style_label_left, color=color.new(color.black, 20), textcolor=color.white, size=size.small)

// Background tint for very-strong tier
bgcolor(buyTier  == 4 ? color.new(color.green, 85) : sellTier == 4 ? color.new(color.red, 85) : na, title="Very-strong tint")

// ─── ALERTS ────────────────────────────────────────────────
alertcondition(buyTier  >= 1, title="Scalp BUY (any)",          message="BUY tier on {{ticker}} @ {{close}}")
alertcondition(buyTier  >= 3, title="Scalp BUY strong+",        message="STRONG BUY on {{ticker}} @ {{close}}")
alertcondition(buyTier  == 4, title="Scalp BUY very strong",    message="VERY STRONG BUY ⏶⏶ on {{ticker}} @ {{close}}")
alertcondition(sellTier >= 1, title="Scalp SELL (any)",         message="SELL tier on {{ticker}} @ {{close}}")
alertcondition(sellTier >= 3, title="Scalp SELL strong+",       message="STRONG SELL on {{ticker}} @ {{close}}")
alertcondition(sellTier == 4, title="Scalp SELL very strong",   message="VERY STRONG SELL ⏷⏷ on {{ticker}} @ {{close}}")
